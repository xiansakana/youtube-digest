# ===== 必填（请替换为真实值，切勿提交本文件） =====
GEMINI_API_KEY=your-gemini-api-key
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
RECIPIENTS=your-recipient@example.com

# ===== 摘要与投递 =====
SENDER_NAME=YouTube 每日摘要
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite
LOOKBACK_HOURS=24
MAX_VIDEOS_PER_DAY=100
BATCH_SIZE=15
MIN_DURATION_SECONDS=120
SUBTITLE_LANGS=zh-Hans,zh-Hant,zh,en
SUBTITLE_MAX_CHARS=60000
SEND_WHEN_EMPTY=false
STATE_RETENTION_DAYS=120

# ===== 调度 =====
TIMEZONE=Asia/Shanghai
SEND_HOUR=12
SEND_MINUTE=0
RUN_ON_START=false

# ===== 可选：无字幕视频的 Gemini 视频直读 =====
ENABLE_VIDEO_SUMMARY=true
VIDEO_SUMMARY_MAX_MINUTES=120
# 视频直读请求之间的最小间隔（秒），避免 5 万 token 级别的请求撞 TPM
VIDEO_REQUEST_INTERVAL_SECONDS=60

# ===== 可选：YouTube 抓取代理 =====
# 云服务器 IP 常被 YouTube 拒绝提供字幕，建议配置非云 IP 的出站代理
# YOUTUBE_PROXY=socks5h://127.0.0.1:40000
